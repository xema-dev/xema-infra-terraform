# CONSUME-mode example values for the DigitalOcean substrate root.
#
# Copy to terraform.tfvars (or a separate *.tfvars passed via -var-file) and
# replace every REPLACE_ME / placeholder with REAL values. NEVER commit real
# tokens or ids — secrets shown here are FAKE placeholders only.
#
# This file demonstrates CONSUME mode: a SEPARATE "cloud substrate" Terraform
# (owned by another team/agent) already owns the cluster, the managed Postgres,
# and the DNS zone. This root then manages ONLY the in-cluster and identity
# resources — RWX storage, workload namespaces, the Keycloak realm, and
# extension claims — and CONSUMES the existing cluster by name.
#
# What changes vs greenfield:
#   - enable_cluster / enable_managed_postgres / enable_dns are FALSE, so the
#     stack creates none of them.
#   - cluster_name names the EXISTING cluster to read for the kube/helm providers.
#   - existing_database_cluster_id hosts any extension `managed_databases` claims.
#   - cluster sizing / postgres sizing / dns inputs are all unset (irrelevant
#     when the modules are disabled).

# --- scope toggles: consume cloud infra, manage only in-cluster + identity resources ---
enable_cluster             = false
enable_managed_postgres    = false
enable_dns                 = false
enable_rwx_storage         = true
enable_workload_namespaces = true
enable_identity_realm      = true

# --- provider credentials (FAKE placeholders) ---
# do_token still reads the existing cluster (data source) + manages buckets.
do_token             = "REPLACE_ME_DO_API_TOKEN"
do_spaces_access_id  = "REPLACE_ME_SPACES_ACCESS_ID"
do_spaces_secret_key = "REPLACE_ME_SPACES_SECRET_KEY"

keycloak_url           = "https://id.example.com"
keycloak_client_id     = "terraform-admin"
keycloak_client_secret = "REPLACE_ME_KEYCLOAK_CLIENT_SECRET"
keycloak_admin_realm   = "master"

# --- global placement ---
region = "fra1"
tags = {
  managed-by = "terraform"
  deployment = "example-consume"
}

# --- consume the existing cluster (read by name; NOT created) ---
cluster_name = "existing-shared-cluster" # the live DOKS cluster owned elsewhere

# --- consume the existing managed Postgres (hosts extension databases) ---
existing_database_cluster_id = "REPLACE_ME_EXISTING_PG_CLUSTER_ID"

# --- consume the existing managed Postgres: manage NO databases on it ---
# platform_databases has no default; [] is the explicit answer for a shared
# cluster (managing a subset there would plan to drop the rest).
platform_databases = []

# --- cluster addons (applied to the consumed cluster) ---
rwx_storage_class_name = "nfs-rwx-storage"
rwx_is_default_class   = false

# --- namespaces: YOUR roster, derived from what you deploy ---
# The stack has no default and refuses to plan without it: which namespaces
# exist is a fact about the workloads you run, not about the substrate. This
# EXAMPLE lists what one deployment of the reference platform uses; yours
# comes from your own distribution.
workload_namespaces = [
  "xema-prod",
  "shared-prod",
  "xema-infra",
  "xema-opencode-workers",
  "xema-biome-sidecars",
  "xema-biome-apis",
  "xema-image-builders",
]

# --- identity realm ---
realm_name         = "xema-example"
realm_display_name = "Xema (example)"

realm_clients = {
  web = {
    client_id           = "web-app"
    access_type         = "PUBLIC"
    valid_redirect_uris = ["https://app.example.com/*"]
    web_origins         = ["https://app.example.com"]
  }
}

realm_roles = ["platform_admin", "org_owner", "member"]

realm_protocol_mappers = {
  org_roles = {
    client         = "web"
    user_attribute = "org_roles"
    claim_name     = "org_roles"
    multivalued    = true
  }
}

# --- extension substrate claims ---
# managed_databases land on existing_database_cluster_id (the consumed cluster).
# dns_records are NOT allowed here while enable_dns = false (the stack fails fast).
extensions = {
  "acme/data-warehouse" = {
    managed_databases = {
      main = { database = "ext_data_warehouse", owner = "data_warehouse" }
    }
  }
}
